    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "6bd2611cdf754f9db1657aa80235fb56",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SkinningFunction (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -855.9999389648438,
            "y": -614.0,
