        {
            "m_Id": "b6d51d49671e438c98519010a3da26d2"
        },
        {
            "m_Id": "42bdc52f14144ba7b85f7df4c66218a9"
        },
        {
            "m_Id": "345da10f8b9241dab4bc2580c058791f"
        },
        {
            "m_Id": "021c25e712824e1e8227d8535d3b46b1"
        },
        {
            "m_Id": "0cd37fe0b7ee4e50b17176f05161197d"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SkinningFunction",
    "m_FunctionSource": "698f6bb1e71babf4bb6795833cd191f4",
    "m_FunctionBody": "float4 skinnedPos = float4(0.0, 0.0, 0.0, 0.0);\r\n   for (int i = 0; i < 4; i++)\r\n   {\r\n        int index = int(blendIndices[i]);\r\n        skinnedPos += mul(boneMatrixArray[index], float4(position, 1.0)) * blendWeights[i];\r    }\r\n\r\n    skinnedPosition = skinnedPos.xyz;\r\n"
}

